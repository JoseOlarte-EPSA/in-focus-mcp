# ════════════════════════════════════════════════════════════════
# IN Focus MCP — Variables de entorno
# Copia este archivo a `.env` y completa los valores reales.
# ════════════════════════════════════════════════════════════════

# ── Servidor MCP ────────────────────────────────────────────────
SERVER_NAME=IN Focus MCP
SERVER_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000
MCP_PATH=/mcp
MCP_TRANSPORT=streamable-http

# Modulo de autenticacion: 'none' o 'bearer'.
MCP_AUTH_MODE=none
# Token obligatorio solo cuando MCP_AUTH_MODE=bearer.
MCP_BEARER_TOKEN=cambia-este-token

# ── Base de datos GRANTS (SQL Server / Azure SQL) ───────────────
# Nombres exactos que lee clients/grants_client.py.
GRANTS_SERVER=tu-servidor.database.windows.net
GRANTS_DATABASE=Apps_Grants
GRANTS_USERNAME=usuario
GRANTS_PASSWORD=contra

# Opcional. Por defecto: ODBC Driver 18 for SQL Server
SQL_DRIVER=ODBC Driver 18 for SQL Server

# ── SQL endpoint de Fabric (service principal) ─────────────────
# Nombres exactos que lee clients/fabric_client.py. Requiere ODBC Driver 18 >= 18.1.
# Endpoint completo desde Warehouse > Settings > SQL connection string.
FABRIC_SQL_ENDPOINT=xxxxxxxx.datawarehouse.fabric.microsoft.com
# Nombre del warehouse o lakehouse al que se conecta.
FABRIC_DATABASE=MiWarehouse
# Directorio (tenant) donde esta registrada la aplicacion.
FABRIC_TENANT_ID=00000000-0000-0000-0000-000000000000
# Application (client) ID de la aplicacion registrada.
FABRIC_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Secreto (credential tipo password) asignado a la aplicacion registrada.
FABRIC_CLIENT_SECRET=cambia-este-secreto
